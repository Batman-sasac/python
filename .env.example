# 로컬/도커에서 복사: cp .env.example .env 후 값 채우기
# 로컬: main.py 가 load_dotenv() 로 .env 로드. Docker 는 compose 에 env_file: .env 를 넣거나 -e 로 주입.

# --- Supabase (필수) ---
SUPABASE_URL=https://xxxx.supabase.co
# 백엔드 insert·RLS 우회에는 service_role 권장 (없으면 ANON_KEY 사용)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- DB 스키마 자동 생성 (쿠폰 테이블 등) — 아래 중 하나 ---
# 방법 A) URI 전체 (Supabase → Settings → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres.xxxx:비밀번호@....pooler.supabase.com:6543/postgres
#
# 방법 B) DB 비밀번호만 (SUPABASE_URL 은 위에 이미 있음)
# Database password = 프로젝트 생성 시 정한 Postgres 비밀번호 (service_role JWT 아님!)
# Supabase → Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your-db-password
# SUPABASE_DB_USE_POOLER=true
# SUPABASE_DB_POOLER_REGION=aws-0-ap-northeast-2
#
# python scripts/sync_supabase_schema.py
# AUTO_SYNC_DB_SCHEMA=true  → 서버 startup 시 쿠폰 테이블 자동 생성
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_USE_POOLER=true
AUTO_SYNC_DB_SCHEMA=false

# --- Apple IAP (선택) ---
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_KEY_ID=
# APPLE_IAP_PRIVATE_KEY=
# APPLE_IAP_BUNDLE_ID=
# APPLE_SUB_PRODUCT_IDS=
# App Store Connect 구독 product_id → OCR 플랜 매핑 (basic=100, pro=250 페이지)
# APPLE_PLAN_BASIC_PRODUCT_IDS=com.example.app.basic.monthly
# APPLE_PLAN_PRO_PRODUCT_IDS=com.example.app.pro.monthly

# 1 / true / yes 만 인식. 켜면 페이지가 2열로 판단될 때 original_text 가 "왼쪽  |  오른쪽" 형태로 합쳐짐.
# 3열 등은 현재 미지원 — 추후 확장 시 별도 변수·로직 추가.
OCR_TWO_COLUMN_LAYOUT=1
