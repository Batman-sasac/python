# 로컬/도커에서 복사: cp .env.example .env 후 값 채우기
# 로컬: main.py 가 load_dotenv() 로 .env 로드. Docker 는 compose 에 env_file: .env 를 넣거나 -e 로 주입.

# --- OCR 2열 보정 (선택) ---
# 1 / true / yes 만 인식. 켜면 페이지가 2열로 판단될 때 original_text 가 "왼쪽  |  오른쪽" 형태로 합쳐짐.
# 3열 등은 현재 미지원 — 추후 확장 시 별도 변수·로직 추가.
OCR_TWO_COLUMN_LAYOUT=1
